# ARCHON Configuration
PORT=3003

# Admin account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Legacy bearer token auth (optional, username/password preferred)
# AUTH_TOKEN=change-me-to-a-secure-random-string

# Claude Code binary path
CLAUDE_PATH=claude

# Default working directory for new sessions
DEFAULT_WORKING_DIR=/home/user/projects

# OpenRouter API key (required for non-Claude models)
# OPENROUTER_API_KEY=sk-or-v1-...
